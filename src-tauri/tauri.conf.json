{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scribe",
  "version": "0.1.0",
  "identifier": "com.georgekiritsis.scribe",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Scribe",
        "width": 1400,
        "height": 860,
        "minWidth": 820,
        "minHeight": 520,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 20
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVFMUE2QTU2OEIwODhDMTcKUldRWGpBaUxWbW9hWGgzWjhyZG8rMll5RVduc3dUMDNGUlRiM1FCZDVOWWdqTkU3NERQYzdVbWMK",
      "endpoints": [
        "https://github.com/GeorgeKiritsis/Scribe/releases/latest/download/latest.json"
      ]
    }
  }
}
